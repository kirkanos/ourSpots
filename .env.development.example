# ---------------------------------------------------------------------------
# Lokale Entwicklung – kopieren nach .env.development
#
#   cp .env.development.example .env.development
#   docker compose -f docker-compose.dev.yml up -d
#   npm run db:migrate
#   npm run db:seed
#   npm run dev
#
# Diese Datei enthaelt bewusst keine echten Geheimnisse: die lokale Umgebung
# laeuft ohne Authelia.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

DATABASE_URL=mysql://womoplaner:womoplaner@127.0.0.1:3307/womoplaner

# Ohne erreichbares Authelia: die App bietet stattdessen eine lokale Anmeldung
# an. Der Server verweigert den Start, wenn das zusammen mit NODE_ENV=production
# gesetzt ist.
DEV_LOGIN=true

# Platzhalter – werden ohne erreichbares Authelia nie benutzt, muessen aber
# formal gueltig sein.
OIDC_ISSUER=http://localhost:9091
OIDC_CLIENT_ID=womoplaner
OIDC_CLIENT_SECRET=nur-lokal-ohne-bedeutung
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback
OIDC_SCOPES=openid profile email groups

SESSION_SECRET=lokaler-entwicklungsschluessel-mindestens-32-zeichen
SESSION_TTL_DAYS=30

# Leer lassen: die Routenberechnung meldet dann verstaendlich, dass der
# Schluessel fehlt, statt undurchsichtig zu scheitern.
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org

NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=WoMoPlaner-Entwicklung (lokal)

PHOTO_DIR=./data/photos
MAX_UPLOAD_MB=25

LOG_LEVEL=debug
