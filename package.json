{
  "name": "ourspots",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @ourspots/shared && npm run build -w @ourspots/api && npm run build -w @ourspots/web",
    "db:apply": "npm run db:apply -w @ourspots/api",
    "db:migrate": "npm run db:migrate -w @ourspots/api",
    "db:seed": "npm run db:seed -w @ourspots/api",
    "db:studio": "npm run db:studio -w @ourspots/api",
    "dev": "./scripts/dev.sh",
    "dev:api": "npm run dev -w @ourspots/api",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d",
    "dev:servers": "concurrently -n shared,api,web -c magenta,green,cyan \"npm:dev:shared\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:shared": "npm run dev -w @ourspots/shared",
    "dev:web": "npm run dev -w @ourspots/web",
    "setup": "./scripts/dev.sh",
    "start": "./scripts/dev.sh",
    "stop": "./scripts/stop.sh",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "sharp@0.34.5": true,
    "esbuild@0.25.12": true
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
