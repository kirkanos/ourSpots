{
  "name": "@ourspots/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && rm -rf dist && tsc -p tsconfig.json",
    "db:apply": "dotenv -e ../../.env.development -- prisma migrate deploy",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env.development -- prisma migrate dev",
    "db:seed": "dotenv -e ../../.env.development -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env.development -- prisma studio",
    "dev": "prisma generate && tsc -p tsconfig.json && dotenv -e ../../.env.development -- concurrently -k -n tsc,api -c blue,green \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@ourspots/shared": "*",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cookie-parser": "^1.4.7",
    "exifr": "^7.1.3",
    "express": "^5.0.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.0",
    "openid-client": "^6.0.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.0",
    "uuid": "^13.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.13.10",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2"
  }
}
