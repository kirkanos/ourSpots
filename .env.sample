# ---------------------------------------------------------------------------
# OurSpots – Konfiguration des Servers
#
# Diese Datei ist die Vorlage. Die echten Werte stehen in .env, die nicht ins
# Repository gehört, sondern verschlüsselt als .env.enc:
#
#   sops --encrypt --input-type dotenv --output-type dotenv --output .env.enc .env
#
# Die Pipeline entschlüsselt sie beim Deploy wieder.
# ---------------------------------------------------------------------------

# --- Deployment ------------------------------------------------------------
# SERVICE bestimmt Verzeichnis (/services/$SERVICE), Containernamen, systemd-Unit
# und die Traefik-Router.
SERVICE=ourspots
HOST=spots.kirkanos.net
# Port des Web-Containers, auf den Traefik zeigt.
PORT=80

APP_URL=https://spots.kirkanos.net

# --- Datenbank -------------------------------------------------------------
MYSQL_DATABASE=ourspots
MYSQL_USER=ourspots
MYSQL_PASSWORD=changeme-db-password
MYSQL_ROOT_PASSWORD=changeme-root-password
# DATABASE_URL wird auf dem Server in der docker-compose.yml aus diesen drei
# Werten zusammengesetzt, weil der Host der eindeutige Alias sein muss und nicht
# der Dienstname "db" – im geteilten Traefik-Netz laufen fremde Container, die
# ebenso heißen können.

# --- Authelia / OIDC -------------------------------------------------------
OIDC_ISSUER=https://auth.kirkanos.net
OIDC_CLIENT_ID=ourspots
OIDC_CLIENT_SECRET=changeme-oidc-secret
OIDC_REDIRECT_URI=https://spots.kirkanos.net/api/auth/callback
OIDC_SCOPES=openid profile email groups

# --- Sessions --------------------------------------------------------------
# openssl rand -hex 32
SESSION_SECRET=changeme-session-secret-at-least-32-chars
SESSION_TTL_DAYS=30

# --- Routing (OpenRouteService) -------------------------------------------
ORS_API_KEY=
# Seit dem Umzug von api.openrouteservice.org auf api.heigit.org liegen
# Routenberechnung und Optimierung unter verschiedenen Basispfaden.
ORS_BASE_URL=https://api.heigit.org/openrouteservice
ORS_OPTIMIZATION_URL=https://api.heigit.org/vroom/v0

# --- Geocoding (Nominatim) -------------------------------------------------
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=OurSpots/0.1 (spots.kirkanos.net)

# --- Fotos -----------------------------------------------------------------
MAX_UPLOAD_MB=25

# --- Karte -----------------------------------------------------------------
# Die Kartenquelle wird beim Bauen in das Frontend-Bundle geschrieben und steht
# deshalb in .woodpecker/pipeline.yaml, nicht hier.

# --- Sonstiges -------------------------------------------------------------
LOG_LEVEL=log

# IMAGE_TAG setzt die Pipeline beim Ausrollen selbst; hier nichts eintragen.
