# ---------------------------------------------------------------------------
# OurSpots – Konfiguration
# Kopiere diese Datei nach .env und fuelle die Werte aus.
# ---------------------------------------------------------------------------

# Oeffentliche URL der App (ohne abschliessenden Slash)
APP_URL=https://travel.kirkanos.net

# --- Datenbank -------------------------------------------------------------
MYSQL_DATABASE=ourspots
MYSQL_USER=ourspots
MYSQL_PASSWORD=changeme-db-password
MYSQL_ROOT_PASSWORD=changeme-root-password
# Wird vom API-Container genutzt; Host "db" ist der Compose-Servicename.
DATABASE_URL=mysql://ourspots:changeme-db-password@db:3306/ourspots

# --- Authelia / OIDC -------------------------------------------------------
# Issuer ist die Basis-URL deiner Authelia-Instanz (ohne /.well-known/...)
OIDC_ISSUER=https://auth.kirkanos.net
OIDC_CLIENT_ID=ourspots
OIDC_CLIENT_SECRET=changeme-oidc-secret
# Muss exakt so in Authelia als redirect_uri eingetragen sein:
OIDC_REDIRECT_URI=https://travel.kirkanos.net/api/auth/callback
OIDC_SCOPES=openid profile email groups

# Anmeldung ohne Authelia – NUR fuer die lokale Entwicklung. Zusammen mit
# NODE_ENV=production verweigert die App den Start.
# DEV_LOGIN=false

# --- Sessions --------------------------------------------------------------
# Zufallswert, z.B. mit: openssl rand -hex 32
SESSION_SECRET=changeme-session-secret-at-least-32-chars
SESSION_TTL_DAYS=30

# --- Routing (OpenRouteService) -------------------------------------------
# Kostenloser Key: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org

# --- Geocoding (Nominatim) -------------------------------------------------
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Pflicht laut Nutzungsbedingungen: identifizierbarer User-Agent mit Kontakt
NOMINATIM_USER_AGENT=OurSpots/0.1 (travel.kirkanos.net)

# --- Fotos -----------------------------------------------------------------
PHOTO_DIR=/data/photos
MAX_UPLOAD_MB=25

# --- Karte -----------------------------------------------------------------
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=&copy; OpenStreetMap-Mitwirkende

# --- Sonstiges -------------------------------------------------------------
PORT=3000
NODE_ENV=production
# error | warn | log | debug | verbose
LOG_LEVEL=log
